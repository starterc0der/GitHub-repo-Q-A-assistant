# Qdrant vector store
QDRANT_URL=http://localhost:6333

# Local embedding model, loaded via sentence-transformers (no API key needed)
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# Local cross-encoder reranker model, loaded via sentence-transformers
RERANKER_MODEL=BAAI/bge-reranker-base

# Local LLM backend, served by Ollama (https://ollama.com)
# Pull whatever model you prefer: `ollama pull llama3.1`
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Where cloned repos are checked out on disk
REPO_CLONE_DIR=./data/repos

# Chunk sizing (approximate tokens, char/4 heuristic)
CHUNK_MAX_CHARS=2000
CHUNK_OVERLAP=200

# Hierarchical routing: how many files the router shortlists per question
TOP_FILES=8

# Hybrid retrieval: candidate pool size before reranking, and dense:bm25 fusion weights
HYBRID_CANDIDATE_K=40
HYBRID_DENSE_WEIGHT=1.0
HYBRID_BM25_WEIGHT=0.25

# Cross-encoder reranking: final number of chunks handed to compression/generation
RERANK_TOP_K=6
